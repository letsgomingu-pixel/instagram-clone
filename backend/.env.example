# Local development (SQLite). Alembic reads this via app/config.py.
DATABASE_URL=sqlite:///./instagram.db

SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MEDIA_ROOT=./media
MAX_UPLOAD_SIZE_MB=10
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
SEED_DEMO_USERS=true

# Shipping (KRW)
BASE_SHIPPING_FEE=4000
FREE_SHIPPING_THRESHOLD=50000

# PortOne payment — leave empty for mock mode in local dev
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_MOCK=true

# Media storage: "local" (default) writes under MEDIA_ROOT. Set to "s3" and
# fill in the three vars below to upload to S3/CloudFront instead — see
# deploy/POSTGRES_AND_S3.md.
STORAGE_BACKEND=local
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
MEDIA_CDN_BASE_URL=
