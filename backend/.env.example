# Local development (SQLite). Alembic reads this via app/config.py.
DATABASE_URL=sqlite:///./instagram.db

SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MEDIA_ROOT=./media
MAX_UPLOAD_SIZE_MB=10
MAX_VIDEO_UPLOAD_SIZE_MB=100
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Keep false — removes public demo login letsgomingu/12345 on startup (pytest sets true).
SEED_DEMO_USERS=false

# Shipping (KRW)
BASE_SHIPPING_FEE=4000

# Public site URL (password reset links, etc.)
FRONTEND_URL=http://localhost:5173

# Email — password reset requires Resend OR SMTP (see below).
# Order/login emails also send when EMAIL_ENABLED=true or delivery is configured.
EMAIL_ENABLED=false
EMAIL_FROM=noreply@iamnotafishmonger.com
# Resend (recommended): https://resend.com — verify your domain, then paste API key
RESEND_API_KEY=
# SMTP fallback (Gmail app password, AWS SES SMTP, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# PortOne payment — leave empty for mock mode in local dev
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_MOCK=true

# Media storage: "local" (default) writes under MEDIA_ROOT. Set to "s3" and
# fill in the three vars below to upload to S3/CloudFront instead — see
# deploy/POSTGRES_AND_S3.md.
STORAGE_BACKEND=local
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
MEDIA_CDN_BASE_URL=
