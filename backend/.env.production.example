# Production (PostgreSQL). Run deploy/setup-postgres.sh first — it prints the
# real DATABASE_URL with a generated password. Alembic uses the same URL.
DATABASE_URL=postgresql+psycopg2://instagram:CHANGE_ME@localhost:5432/instagram

# deploy.sh generates a fresh random value here automatically. If you create
# this file by hand instead, replace it with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MEDIA_ROOT=./media
MAX_UPLOAD_SIZE_MB=10
ALLOWED_ORIGINS=https://iamnotafishmonger.com,https://www.iamnotafishmonger.com
# Keep false in production — true auto-creates admin/pass123 and
# letsgomingu/12345 login accounts on every server restart.
SEED_DEMO_USERS=false

# Leave as "local" until you've done the S3/CloudFront setup in
# deploy/POSTGRES_AND_S3.md — flipping this without a real bucket configured
# breaks every upload.
STORAGE_BACKEND=local
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
MEDIA_CDN_BASE_URL=
